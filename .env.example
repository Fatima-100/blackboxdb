# Copy this file to .env and fill in your own values. Never commit .env.
DB_SERVER=localhost
DB_NAME=blackboxdb
DB_DRIVER=ODBC Driver 17 for SQL Server
DB_TRUSTED_CONNECTION=yes
# DB_USER=
# DB_PASSWORD=

FLASK_SECRET_KEY=change-me

# Email (B11). console prints emails to the terminal.
MAIL_MODE=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=

# AI summary (B12). Leave empty to switch it off.
AI_API_KEY=
AI_MODEL=
